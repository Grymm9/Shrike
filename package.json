{
  "name": "shrike",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first endpoint triage for bug bounty recon: filter, score, rank, sync.",
  "type": "module",
  "main": "electron/main.js",
  "author": "Shrike",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/shot.cjs",
    "seed:demo": "node scripts/seed.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dev.shrike.desktop",
    "productName": "Shrike",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Shrike-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Shrike"
    },
    "portable": {
      "artifactName": "Shrike-${version}-Portable.${ext}"
    }
  }
}
